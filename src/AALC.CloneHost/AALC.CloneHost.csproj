<Project Sdk="Microsoft.NET.Sdk">
  <!-- 独立进程承载 RDP ActiveX。使用系统自带的 .NET Framework，发布包无需附带 WindowsDesktop 运行时。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net48</TargetFramework>
    <AssemblyName>AAALC.CloneHost</AssemblyName><RootNamespace>AALC.CloneHost</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms><PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>disable</ImplicitUsings><Nullable>disable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../AALC.Desktop/Assets/Logo.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><Reference Include="Microsoft.CSharp" /></ItemGroup>
</Project>
