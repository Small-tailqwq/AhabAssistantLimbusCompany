<Window x:Class="AALC.Desktop.ThemeWeightEditorWindow"
 xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:AALC.Desktop"
 x:DataType="local:ThemeWeightEditorModel" Title="主题卡包权重" Width="1120" Height="820" MinWidth="880" MinHeight="620"
 WindowStartupLocation="CenterOwner">
 <Grid Margin="24,20,24,24" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
  <Grid ColumnDefinitions="180,*,Auto,90" ColumnSpacing="14">
   <ComboBox ItemsSource="{Binding Modes}" SelectedIndex="{Binding ModeIndex}" AutomationProperties.Name="卡包难度"/>
   <TextBox x:Name="SearchBox" Grid.Column="1" Text="{Binding SearchText}" PlaceholderText="搜索卡包" AutomationProperties.Name="搜索卡包"/>
   <TextBlock Grid.Column="2" Text="优选阈值" VerticalAlignment="Center"/>
   <NumericUpDown Grid.Column="3" Value="{Binding PreferredThreshold}" Minimum="-10" Maximum="10" AutomationProperties.Name="卡包优选阈值"/>
  </Grid>
  <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
   <StackPanel Orientation="Horizontal" Spacing="10">
    <Button Content="重置为默认" ToolTip.Tip="重置当前模式的全部卡包">
     <Button.Flyout><MenuFlyout><MenuItem Header="确认重置当前模式的全部卡包" Command="{Binding ResetDefaultsCommand}"/></MenuFlyout></Button.Flyout>
    </Button>
    <Button Content="全部设为 -5" ToolTip.Tip="修改当前模式的全部卡包">
     <Button.Flyout><MenuFlyout><MenuItem Header="确认将当前模式的全部卡包设为 -5" Command="{Binding SetAllLowCommand}"/></MenuFlyout></Button.Flyout>
    </Button>
    <Button Content="普通同步到困难" ToolTip.Tip="同步两种难度共有的卡包，保留困难专属卡包的权重">
     <Button.Flyout><MenuFlyout><MenuItem Header="确认覆盖困难模式共有卡包的权重" Command="{Binding CopyNormalToHardCommand}"/></MenuFlyout></Button.Flyout>
    </Button>
   </StackPanel>
   <TextBlock Grid.Column="1" Text="{Binding CountLabel}" Classes="muted" VerticalAlignment="Center"/>
  </Grid>
  <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
   <ItemsControl ItemsSource="{Binding VisiblePacks}">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:ThemePackItem">
     <Border Width="160" Margin="0,0,12,14" Padding="10" CornerRadius="10" Background="{DynamicResource SurfaceCardBrush}" BorderThickness="2" BorderBrush="{Binding Outline}">
      <Grid RowDefinitions="190,36,42" RowSpacing="10">
       <Border CornerRadius="6" ClipToBounds="True" Background="Transparent">
        <Image Source="{Binding Cover}" Stretch="Uniform" Opacity="{Binding CoverOpacity}"/>
       </Border>
       <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="13" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" TextAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="{Binding FullName}"/>
       <NumericUpDown Grid.Row="2" Value="{Binding Weight}" Minimum="-10" Maximum="10" AutomationProperties.Name="{Binding Name}"/>
      </Grid>
     </Border>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
  </ScrollViewer>
  <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="18">
   <TextBlock Text="{Binding Error}" Classes="error" VerticalAlignment="Center"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
    <Button Content="取消" Click="Cancel" MinWidth="90"/>
    <Button Content="应用" Click="Apply" Classes="primary" MinWidth="100"/>
   </StackPanel>
  </Grid>
 </Grid>
</Window>
