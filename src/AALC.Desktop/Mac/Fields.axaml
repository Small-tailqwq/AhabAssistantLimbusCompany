<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style Selector="TextBox.field, ComboBox.field">
  <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
  <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
  <Setter Property="Padding" Value="12,0"/>
 </Style>
 <Style Selector="TextBox.field">
  <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="CaretBrush" Value="{DynamicResource AngelaIceBrush}"/>
  <Setter Property="PlaceholderForeground" Value="{DynamicResource TextSecondaryBrush}"/>
  <Setter Property="SelectionBrush" Value="{DynamicResource AccentFillBrush}"/>
 </Style>
 <Style Selector="ComboBox.field">
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="PlaceholderForeground" Value="{DynamicResource TextSecondaryBrush}"/>
 </Style>
 <Style Selector="TextBox.field:pointerover /template/ Border#border, ComboBox.field:pointerover /template/ Border#border">
  <Setter Property="BorderBrush" Value="{DynamicResource TextTertiaryBrush}"/>
 </Style>
 <Style Selector="TextBox.field:focus-within /template/ Border#border, ComboBox.field:focus-visible /template/ Border#border, ComboBox.field[IsDropDownOpen=True] /template/ Border#border">
  <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
  <Setter Property="BoxShadow" Value="{DynamicResource MacFieldFocusShadow}"/>
 </Style>
 <Style Selector="ComboBox.field /template/ ToggleButton#toggle">
  <Setter Property="Width" Value="30"/><Setter Property="Padding" Value="0"/>
  <Setter Property="Template">
   <ControlTemplate>
    <Border Background="Transparent">
     <Path Width="10" Height="6" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
      StrokeLineCap="Round" StrokeJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"
      Data="M1,1 L5,5 L9,1"/>
    </Border>
   </ControlTemplate>
  </Setter>
 </Style>
 <Style Selector="ComboBox.field /template/ Popup#PART_Popup > Border">
  <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
  <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
  <Setter Property="Padding" Value="4"/>
 </Style>
 <Style Selector="ComboBoxItem">
  <Setter Property="Padding" Value="10,7"/><Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
 </Style>
 <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
  <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
 </Style>
 <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
  <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
 </Style>
 <Style Selector="TextBlock.field-label">
  <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
  <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
  <Setter Property="FontWeight" Value="Medium"/>
 </Style>
</Styles>
