<Window x:Class="AALC.Desktop.Mac.EmulatorWindow"
 xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:AALC.Desktop.Mac" xmlns:android="using:AALC.Platform.Android" x:DataType="local:EmulatorViewModel"
 Title="AAALC · 模拟器工作台" Width="960" Height="706" MinWidth="480" MinHeight="440" WindowStartupLocation="CenterScreen"
 Background="{DynamicResource MacGlassTint}" TransparencyBackgroundFallback="{DynamicResource SurfaceWindowBrush}">
 <Window.KeyBindings><KeyBinding Gesture="Escape" Command="{Binding StopCommand}"/></Window.KeyBindings>
 <Window.Styles>
  <Style Selector="Window.compact StackPanel#Tools"><Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="2"/></Style>
  <Style Selector="Window:not(.compact) StackPanel#Tools"><Setter Property="Grid.Column" Value="1"/></Style>
  <Style Selector="Window.compact Border#Connection"><Setter Property="Grid.ColumnSpan" Value="2"/></Style>
  <Style Selector="TextBlock.kicker"><Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/><Setter Property="LetterSpacing" Value="1.8"/><Setter Property="Foreground" Value="{DynamicResource AngelaIceBrush}"/></Style>
  <Style Selector="Border#DeviceLight"><Setter Property="Opacity" Value=".35"/><Setter Property="Background" Value="{DynamicResource AccentBrush}"/></Style>
  <Style Selector="Border#DeviceLight.selected"><Setter Property="Opacity" Value="1"/><Setter Property="Background" Value="{DynamicResource SuccessBrush}"/></Style>
  <Style Selector="Image#Frame"><Setter Property="Opacity" Value="0"/></Style>
  <Style Selector="Image#Frame.available"><Setter Property="Opacity" Value="1"/></Style>
  <Style Selector="Border#Activity"><Setter Property="Opacity" Value="0"/></Style>
  <Style Selector="Border#Activity.running"><Setter Property="Opacity" Value="1"/></Style>
  <Style Selector="Window.motion Image#Frame, Window.motion Border#DeviceLight, Window.motion Border#Activity">
   <Setter Property="Transitions"><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut"/></Transitions></Setter>
  </Style>
 </Window.Styles>
 <Grid Classes="page" RowDefinitions="Auto,*,Auto">
  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource CardSpacing}">
   <Image Source="/Assets/Logo.png" Height="{DynamicResource LogoSidebarSize}" Width="{DynamicResource LogoSidebarSize}"/>
   <StackPanel Grid.Column="1" VerticalAlignment="Center">
    <TextBlock Classes="kicker" Text="AAALC   /   MACOS"/>
    <TextBlock Classes="heading" Text="模拟器工作台"/>
   </StackPanel>
   <Border Grid.Column="2" Classes="inset" VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource RowSpacing}">
     <Border Name="DeviceLight" Classes.selected="{Binding DeviceSelected}"
      Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"/>
     <TextBlock Classes="caption" Text="{Binding DeviceLabel}"/>
    </StackPanel>
   </Border>
  </Grid>
  <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
   <Grid ColumnDefinitions="4*,6*" RowDefinitions="Auto,Auto" ColumnSpacing="{DynamicResource CardSpacing}" RowSpacing="{DynamicResource CardSpacing}">
    <Border Name="Connection" Classes="card" VerticalAlignment="Top">
     <StackPanel Classes="options" IsEnabled="{Binding Idle}">
      <TextBlock Classes="kicker" Text="01   /   DEVICE"/>
      <TextBlock Classes="section" Text="连接设备"/>
      <TextBlock Classes="muted" TextWrapping="Wrap" Text="在模拟器中开启 ADB。已连接的设备可直接刷新。"/>
      <TextBlock Classes="caption" Text="本机 ADB 端口"/>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource RowSpacing}">
       <TextBox Text="{Binding Port}" PlaceholderText="例如 5555" AutomationProperties.Name="本机 ADB 端口"/>
       <Button Grid.Column="1" Content="连接" Command="{Binding ConnectCommand}"/>
      </Grid>
      <TextBlock Classes="caption" Text="目标模拟器"/>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource RowSpacing}">
       <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding Selected}" PlaceholderText="未选择" AutomationProperties.Name="目标模拟器">
        <ComboBox.ItemTemplate><DataTemplate x:DataType="android:AdbDevice">
         <TextBlock Text="{Binding Serial}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Serial}"/>
        </DataTemplate></ComboBox.ItemTemplate>
       </ComboBox>
       <Button Grid.Column="1" Content="刷新" Command="{Binding RefreshCommand}"/>
      </Grid>
      <Separator/>
      <TextBlock Classes="caption" Text="模板语言与主题"/>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource RowSpacing}">
       <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" AutomationProperties.Name="游戏语言"/>
       <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" AutomationProperties.Name="图像主题"/>
      </Grid>
      <TextBlock Classes="caption" Text="资源目录"/>
      <TextBox Text="{Binding Repository}" AutomationProperties.Name="资源目录" ToolTip.Tip="{Binding Repository}"/>
     </StackPanel>
    </Border>
    <StackPanel Name="Tools" Classes="cards">
     <Border Classes="card">
      <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{DynamicResource RowSpacing}">
       <Grid ColumnDefinitions="*,Auto">
        <StackPanel><TextBlock Classes="kicker" Text="02   /   MONITOR"/><TextBlock Classes="section" Text="游戏画面"/></StackPanel>
        <TextBlock Grid.Column="1" Classes="caption" VerticalAlignment="Center" Text="16:9  ·  ≥ 1280 × 720"/>
       </Grid>
       <Border Grid.Row="1" Classes="inset" Padding="0" Background="{DynamicResource MacMonitorBrush}" ClipToBounds="True">
        <Grid Height="{DynamicResource MacPreviewHeight}">
         <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="{DynamicResource RowSpacing}" IsVisible="{Binding !HasPreview}">
          <PathIcon Width="40" Height="40" Foreground="{DynamicResource AngelaIceBrush}"
           Data="M2,9 V2 H9 V4 H4 V9 Z M15,2 H22 V9 H20 V4 H15 Z M22,15 V22 H15 V20 H20 V15 Z M9,22 H2 V15 H4 V20 H9 Z M8,11 H11 V8 H13 V11 H16 V13 H13 V16 H11 V13 H8 Z"/>
          <TextBlock HorizontalAlignment="Center" Text="等待游戏画面"/>
          <TextBlock HorizontalAlignment="Center" Classes="caption" Text="截图或领取邮件时显示最新帧"/>
         </StackPanel>
         <Image Name="Frame" Classes.available="{Binding HasPreview}" Source="{Binding Preview}" Stretch="Uniform" AutomationProperties.Name="最近一帧游戏画面"/>
         <Border Name="Activity" Classes.running="{Binding Busy}" Height="2" VerticalAlignment="Top" Background="{DynamicResource AccentBrush}"/>
        </Grid>
       </Border>
       <WrapPanel Grid.Row="2" ItemSpacing="{DynamicResource RowSpacing}" LineSpacing="{DynamicResource RowSpacing}">
        <Button Content="保存截图" Command="{Binding CaptureCommand}"/>
        <Button Classes="primary" Content="领取邮件" ToolTip.Tip="请从游戏主页开始" Command="{Binding MailCommand}"/>
       </WrapPanel>
      </Grid>
     </Border>
     <Border Classes="card">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="{DynamicResource RowSpacing}" RowSpacing="{DynamicResource RowSpacing}">
       <TextBlock Classes="section" Text="离线邮件回放"/>
       <ComboBox Grid.Row="1" ItemsSource="{Binding Scenarios}" SelectedItem="{Binding Scenario}" IsEnabled="{Binding Idle}" AutomationProperties.Name="离线邮件场景"/>
       <Button Grid.Row="1" Grid.Column="1" Content="回放" Command="{Binding ReplayCommand}"/>
      </Grid>
     </Border>
    </StackPanel>
   </Grid>
  </ScrollViewer>
  <Grid Grid.Row="2" Classes="actions" ColumnDefinitions="*,Auto">
   <StackPanel Orientation="Vertical" Spacing="0">
    <TextBlock Classes="caption" Text="任务状态"/>
    <SelectableTextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
    <SelectableTextBlock Classes="error" Foreground="{DynamicResource DangerTextBrush}" Text="{Binding Error}" IsVisible="{Binding !!Error}" TextWrapping="Wrap"/>
   </StackPanel>
   <Button Grid.Column="1" Content="停止" Classes="danger" IsVisible="{Binding Busy}" Command="{Binding StopCommand}"/>
  </Grid>
 </Grid>
</Window>
