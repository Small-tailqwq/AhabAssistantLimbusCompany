<!--
 超链接：替换 SukiUI 默认的蓝色下划线文字。
 默认为次要文字色加外链箭头；悬停时文字提亮、箭头向右上微移、主色细线自左展开。
 .pill 为描边胶囊按钮，用于页面主要外链（如关于页仓库链接）。
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ControlTheme x:Key="{x:Type HyperlinkButton}" TargetType="HyperlinkButton">
  <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
  <Setter Property="Background" Value="{DynamicResource SurfaceHoverClearBrush}"/>
  <Setter Property="BorderBrush" Value="Transparent"/>
  <Setter Property="BorderThickness" Value="0"/>
  <Setter Property="Padding" Value="0,2"/>
  <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="VerticalAlignment" Value="Center"/>
  <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
  <Setter Property="Template">
   <ControlTemplate>
    <Border Name="PART_Background" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
     BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
     <Border.Transitions><Transitions><BrushTransition Property="Background" Duration="0:0:0.16"/><BrushTransition Property="BorderBrush" Duration="0:0:0.16"/></Transitions></Border.Transitions>
     <Grid RowDefinitions="*,Auto" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal" Spacing="6">
       <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
       <Path Name="PART_Arrow" Data="M2.5,1.5 L8.5,1.5 L8.5,7.5 M8.5,1.5 L1.5,8.5" Width="10" Height="10" Stretch="None"
        Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center" Opacity="0.7">
        <Path.Transitions><Transitions>
         <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut"/>
         <DoubleTransition Property="Opacity" Duration="0:0:0.16"/>
        </Transitions></Path.Transitions>
       </Path>
      </StackPanel>
      <Border Name="PART_Underline" Grid.Row="1" Height="1" Margin="0,3,0,0" Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0%,50%">
       <Border.Transitions><Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut"/></Transitions></Border.Transitions>
      </Border>
     </Grid>
    </Border>
   </ControlTemplate>
  </Setter>
  <Setter Property="Transitions"><Transitions><BrushTransition Property="Foreground" Duration="0:0:0.16"/></Transitions></Setter>

  <Style Selector="^ /template/ Border#PART_Underline"><Setter Property="RenderTransform" Value="scaleX(0)"/></Style>
  <Style Selector="^ /template/ Path#PART_Arrow"><Setter Property="RenderTransform" Value="translate(0px,0px)"/></Style>
  <Style Selector="^:pointerover, ^:focus-visible">
   <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
   <Style Selector="^ /template/ Border#PART_Underline"><Setter Property="RenderTransform" Value="scaleX(1)"/></Style>
   <Style Selector="^ /template/ Path#PART_Arrow"><Setter Property="RenderTransform" Value="translate(1.5px,-1.5px)"/><Setter Property="Opacity" Value="1"/></Style>
  </Style>
  <Style Selector="^:pressed"><Setter Property="Opacity" Value="0.75"/></Style>
  <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.45"/></Style>

  <!-- 胶囊：描边底，悬停填充，不显示下划线。 -->
  <Style Selector="^.pill">
   <Setter Property="Padding" Value="14,8"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
   <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
   <Style Selector="^ /template/ Border#PART_Underline"><Setter Property="IsVisible" Value="False"/></Style>
   <Style Selector="^:pointerover /template/ Border#PART_Background, ^:focus-visible /template/ Border#PART_Background">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
   </Style>
  </Style>
 </ControlTheme>
</ResourceDictionary>
