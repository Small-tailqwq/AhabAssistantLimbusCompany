<Application x:Class="AALC.Desktop.App"
 xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:suki="https://github.com/kikipoulet/SukiUI" RequestedThemeVariant="Dark">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="/Styles/Tokens.axaml"/>
    <ResourceInclude Source="/Styles/Logos.axaml"/>
    <ResourceInclude Source="/Styles/Expander.axaml"/>
    <ResourceInclude Source="/Styles/Hyperlink.axaml"/>
    <ResourceInclude Source="/Styles/Button.axaml"/>
   </ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </Application.Resources>
 <Application.Styles>
  <suki:SukiTheme ThemeColor="Blue"/>
  <StyleInclude Source="/Styles/Controls.axaml"/>
 </Application.Styles>
</Application>
